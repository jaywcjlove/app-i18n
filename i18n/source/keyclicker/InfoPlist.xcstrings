    "NSInputMonitoringUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App muss deine Tastatureingaben überwachen, um Sounds abzuspielen und die gedrückten Tasten anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app needs to monitor your keyboard input in order to play sounds and display the keys you press."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app doit surveiller vos saisies au clavier pour lire des sons et afficher les touches que vous appuyez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app deve monitorare l'input della tastiera per riprodurre i suoni e mostrare i tasti premuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは、サウンドを再生し、押したキーを表示するために、キーボード入力を監視する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 사운드를 재생하고 누른 키를 표시하기 위해 키보드 입력을 모니터링해야 합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приложение должно отслеживать ввод с клавиатуры, чтобы воспроизводить звуки и отображать нажимаемые клавиши."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会监控键盘输入，为每个按键播放音效，并显示当前按下的按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此應用程式需要監視您的鍵盤輸入，以播放聲音和顯示您按下的按鍵。"
          }
        }
      }
    }
  },
  "version" : "1.0"
