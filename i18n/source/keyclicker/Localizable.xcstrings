          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サウンド再生と押したキーの表示を有効にするには、アプリに入力監視権限を付与してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
