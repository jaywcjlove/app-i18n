    "The press and release sounds are defined by the file name suffixes %@ and %@, respectively." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The press and release sounds are defined by the file name suffixes %1$@ and %2$@, respectively."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过文件名后缀 %1$@ 和 %2$@，分别定义按下和抬起时的音效。\n"
          }
        }
      }
    },
    "This app needs to monitor your keyboard input in order to play sounds and display the keys you press." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会监控键盘输入，为每个按键播放音效，并显示当前按下的按键。"
          }
        }
      }
    },
    "This key has been muted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该按键已被设置为静音。"
          }
        }
      }
    },
