    "10 sounds free by default" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 Sounds standardmäßig kostenlos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 sons gratuits par défaut"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 suoni gratuiti inclusi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準で10種類のサウンドが無料"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본으로 10개의 사운드가 무료로 제공됩니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
