    "A set of mechanical keyboard key sounds with minimal tonal differences, supporting both key press and release sounds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Reihe mechanischer Tastaturtöne mit minimalen Klangunterschieden, die sowohl Töne beim Drücken als auch beim Loslassen unterstützt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ensemble de sons de clavier mécanique avec de faibles différences de timbre, prenant en charge les sons à l'appui et au relâchement des touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una raccolta di suoni per tastiera meccanica con differenze di timbro minime, con supporto sia per il suono alla pressione sia al rilascio dei tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色差の少ないメカニカルキーボード向けのキーサウンド集です。キーの押下時と離した時の両方に対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음색 차이가 적은 기계식 키보드 키 사운드 모음으로, 키를 누를 때와 뗄 때의 사운드를 모두 지원합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набор звуков механической клавиатуры с минимальными тональными различиями, поддерживающий звуки как при нажатии, так и при отпускании клавиши."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一套机械键盘按键音效，音色差异小，并支持按键按下与抬起的声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一組機械鍵盤按鍵聲音，音調差異極小，支援按鍵按下和釋放兩種聲音。"
          }
        }
      }
    },
