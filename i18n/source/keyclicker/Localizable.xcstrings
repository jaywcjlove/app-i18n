            "value" : "사운드 재생과 누른 키 표시를 사용하려면 앱에 입력 모니터링 권한을 허용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы включить воспроизведение звука и отображение нажатых клавиш, предоставьте приложению разрешение на мониторинг входных данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请为该应用开启输入监控权限，以便播放声音并显示你按下的按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
