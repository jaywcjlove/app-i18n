    "To enable sound playback and display of pressed keys, please grant the app Input Monitoring permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte gewähre der App die Berechtigung zur Eingabeüberwachung, damit Sounds abgespielt und gedrückte Tasten angezeigt werden können."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour activer la lecture des sons et l'affichage des touches pressées, veuillez accorder à l'app l'autorisation de surveillance de la saisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
