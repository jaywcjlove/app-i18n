    "In Keyboard & Mouse mode, press %@ to show or hide Launchpad (works even when Show Launchpad is off)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Tastatur- und Mausmodus %@ drücken, um Launchpad ein- oder auszublenden (funktioniert auch wenn „Launchpad anzeigen\" deaktiviert ist)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode Clavier et souris, appuyez sur %@ pour afficher ou masquer Launchpad (fonctionne même si Afficher Launchpad est désactivé)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In modalità Tastiera e mouse, premi %@ per mostrare o nascondere Launchpad (funziona anche quando Mostra Launchpad è disattivato)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボード＆マウスモードで、%@ を押して Launchpad を表示／非表示にします（「Launchpad を表示」がオフでも機能します）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드 & 마우스 모드에서 %@을 누르면 런치패드를 표시하거나 숨길 수 있습니다（런치패드 표시가 꺼진 경우에도 작동합니다）"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме «Клавиатура и мышь» нажмите %@, чтобы показать или скрыть Launchpad (работает, даже если «Показывать Launchpad» отключено)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在键盘与鼠标模式下，按 %@ 显示或隐藏启动台（即使\"显示启动台\"已关闭也有效）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在鍵盤與滑鼠模式下，按 %@ 顯示或隱藏啟動台（即使「顯示啟動台」已關閉也有效）"
          }
        }
      }
    },
