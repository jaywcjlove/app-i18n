          }
        }
      }
    },
    "To enable the ability to listen for shortcuts and move the mouse, please grant the app Accessibility permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Kurzbefehle abhören und die Maus bewegen zu können, erteile der App die Berechtigung für Bedienungshilfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour permettre l'écoute des raccourcis et le déplacement de la souris, accordez à l'application l'autorisation d'accessibilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per abilitare l'ascolto delle scorciatoie e il movimento del mouse, concedi all'applicazione l'autorizzazione di accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを監視してマウスを動かす機能を有効にするには、アプリにアクセシビリティ権限を付与してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 감지하고 마우스를 움직일 수 있게 하려면 앱에 접근성 권한을 부여하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы включить возможность отслеживать сочетания клавиш и перемещать мышь, предоставьте приложению доступ к специальным возможностям."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要启用监听快捷键和移动鼠标的功能，请授予该应用辅助功能权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要讓應用程式偵聽快捷鍵並移動滑鼠，請授予其協助工具權限。"
          }
        }
      }
    },
    "Type letter shortcuts on icons to open apps. Press %@ to clear input and re-type." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Buchstaben-Kurzbefehle auf Symbolen ein, um Apps zu öffnen. Drücke %@, um die Eingabe zu löschen und neu einzugeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez des raccourcis par lettres sur les icônes pour ouvrir les applications. Appuyez sur %@ pour effacer la saisie et recommencer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita scorciatoie di lettere sulle icone per aprire le app. Premi %@ per cancellare l'input e riscriverlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイコンに文字ショートカットを入力してアプリを開きます。%@ を押すと入力を消去してやり直せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이콘에 문자 단축키를 입력해 앱을 열 수 있습니다. %@를 눌러 입력을 지우고 다시 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите буквенные сочетания на значках, чтобы открывать приложения. Нажмите %@, чтобы очистить ввод и ввести заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在图标上输入字母快捷键即可打开应用。按 %@ 可清除输入并重新输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在圖示上輸入字母快捷鍵即可開啟應用程式。按 %@ 可清除輸入並重新輸入。"
          }
        }
      }
    },
    "Unfocus search when focused; otherwise exit Keyboard & Mouse mode" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchfeld deaktivieren, wenn es fokussiert ist; sonst Tastatur- und Mausmodus verlassen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désélectionner la recherche si elle est active ; sinon quitter le mode clavier et souris"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseleziona la ricerca se è attiva; altrimenti esci dalla modalità tastiera e mouse"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索欄がフォーカスされている場合はフォーカスを外し、そうでなければキーボード＆マウスモードを終了します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색창이 포커스된 경우 포커스를 해제하고, 그렇지 않으면 키보드 및 마우스 모드를 종료합니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снять фокус с поиска, если он активен; иначе выйти из режима «Клавиатура и мышь»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当搜索栏已聚焦时取消聚焦；否则退出键盘和鼠标模式"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若搜尋欄已聚焦，則取消聚焦；否則退出鍵盤與滑鼠模式"
          }
        }
      }
    },
    "Unlock all Features" : {
