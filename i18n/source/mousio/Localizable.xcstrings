    "Highlight the screen where the mouse is located to focus on the current working area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Bildschirm hervorheben, auf dem sich die Maus befindet, um den aktuellen Arbeitsbereich zu fokussieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre en surbrillance l'écran sur lequel la souris est positionnée pour focaliser la zone de travail actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evidenzia lo schermo in cui si trova il mouse per focalizzare l'area di lavoro corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスがある画面を強調表示して、現在の作業領域にフォーカスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스가 있는 화면을 강조해 현재 작업 영역에 초점을 맞춥니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсветить экран, на котором находится курсор, чтобы сфокусироваться на текущей рабочей области."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高亮鼠标光标所在屏幕，聚焦当前操作区域"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高亮顯示滑鼠所在的畫面，聚焦目前的工作區域。"
          }
        }
      }
    },
    "Hold %@ and press direction keys to move %@ at a time. Choose None to disable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte %1$@ und drücke die Richtungstasten, um jeweils %2$@ zu bewegen. Wähle Keine, um dies zu deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %1$@ and press direction keys to move %2$@ at a time. Choose None to disable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez %1$@ et appuyez sur les touches de direction pour déplacer %2$@ à la fois. Choisissez Aucun pour désactiver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto %1$@ e premi i tasti direzionali per spostarti di %2$@ alla volta. Scegli Nessuno per disattivare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ を押したまま方向キーを押すと、一度に %2$@ ずつ移動します。無効にするには「なし」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 키를 누른 채 방향키를 누르면 한 번에 %2$@씩 이동합니다. 비활성화하려면 없음을 선택하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте %1$@ и нажимайте клавиши со стрелками, чтобы перемещаться на %2$@ за раз. Выберите Нет, чтобы отключить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %1$@ 并按方向键，每次移动 %2$@。选择“不使用”即可禁用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %1$@ 並按方向鍵，每次移動 %2$@。選擇「無」即可停用。"
          }
        }
      }
    },
    "Hold %@ and use %@ to move windows, select text, and move files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte %1$@ und nutze %2$@, um Fenster zu bewegen, Text auszuwählen und Dateien zu verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %1$@ and use %2$@ to move windows, select text, and move files."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez %1$@ et utilisez %2$@ pour déplacer des fenêtres, sélectionner du texte et déplacer des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto %1$@ e usa %2$@ per spostare finestre, selezionare testo e spostare file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ を押しながら %2$@ を使って、ウィンドウを移動したり、テキストを選択したり、ファイルを移動したりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@를 누른 채 %2$@를 사용해 창을 이동하고, 텍스트를 선택하고, 파일을 옮깁니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте %1$@ и используйте %2$@, чтобы перемещать окна, выделять текст и переносить файлы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %1$@ 键，配合 %2$@ 键可移动窗口、选择文本、移动文件等。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %1$@ 並使用 %2$@，即可移動視窗、選取文字與移動檔案。"
          }
        }
      }
    },
    "How many times each mode was entered after enabling Keyboard & Mouse mode (Launchpad, Grid, Arrow Keys, Element)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie oft jeder Modus nach dem Aktivieren des Tastatur- und Mausmodus betreten wurde (Launchpad, Raster, Pfeiltasten, Elemente)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d’entrées dans chaque mode après l’activation du mode Clavier et souris (Launchpad, Grille, Flèches, Éléments)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quante volte è stata attivata ogni modalità dopo l’abilitazione di Tastiera e mouse (Launchpad, Griglia, Frecce, Elementi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボード＆マウスモードを有効にした後、各モード（Launchpad、グリッド、矢印キー、要素）に入った回数。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드 및 마우스 모드를 켠 뒤 각 모드(런치패드, 격자, 방향키, 요소)에 진입한 횟수입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько раз каждый режим включался после активации режима «Клавиатура и мышь» (Launchpad, сетка, стрелки, элементы)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用键鼠模式后，各子模式（启动台、网格导航、方向键导航、元素导航）的进入次数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用鍵鼠模式後，各子模式（啟動台、格線導覽、方向鍵導覽、元件導覽）的進入次數。"
          }
        }
      }
    },
