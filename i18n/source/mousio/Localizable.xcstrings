          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A, K, Shift+A, ⌘+C와 같은 키 조합이 선택한 기간에 대해 집계됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
