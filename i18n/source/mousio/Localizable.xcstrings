    "Page dots: type digits for pages 1–99 (e.g. 1, 12). Pages 100+ use one letter + one digit (e.g. A0, B3)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitenpunkte: Gib Ziffern für Seiten 1–99 ein (z. B. 1, 12). Seiten 100+ verwenden einen Buchstaben + eine Ziffer (z. B. A0, B3)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Points de page : saisissez des chiffres pour les pages 1–99 (par ex. 1, 12). Les pages 100+ utilisent une lettre + un chiffre (par ex. A0, B3)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punti pagina: digita cifre per le pagine 1–99 (ad es. 1, 12). Le pagine 100+ usano una lettera + una cifra (ad es. A0, B3)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページドット: 1〜99 ページは数字を入力（例: 1、12）。100 ページ以上は 1 文字＋1 桁（例: A0、B3）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지 도트: 1–99페이지는 숫자 입력(예: 1, 12). 100페이지 이상은 문자 1개와 숫자 1개(예: A0, B3) 사용."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точки страниц: вводите цифры для страниц 1–99 (например, 1, 12). Для страниц 100+ используйте одну букву и одну цифру (например, A0, B3)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分页点：输入 1–99 的数字可切换页面（例如 1、12）。100+ 页使用一个字母 + 一个数字（例如 A0、B3）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頁點：輸入 1–99 的數字表示頁碼（例如 1、12）。100 以上則使用一個字母加一個數字（例如 A0、B3）。"
          }
        }
      }
    },
