          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ -> **%2$@** -> **%3$@** -> Add **%4$@** and check"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ -> **%2$@** -> **%3$@** -> Ajouter **%4$@** et vérifier"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
