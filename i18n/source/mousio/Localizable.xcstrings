    "%@ the %@ key to enter keyboard mouse mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ die %2$@-Taste, um den Tastatur-Maus-Modus zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ the %2$@ key to enter keyboard mouse mode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ la touche %2$@ pour entrer en mode souris au clavier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ il tasto %2$@ per entrare nella modalità mouse da tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ キーでキーボードマウスモードに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 키를 눌러 키보드 마우스 모드로 진입합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ клавишу %2$@, чтобы войти в режим клавиатурной мыши."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 键以进入键盘鼠标模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
