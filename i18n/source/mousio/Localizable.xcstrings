    "Use %@ to move the cursor, and press %@ to exit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze %1$@, um den Cursor zu bewegen, und drücke %2$@, um zu beenden."
          }
        },
