          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ -> **%2$@** -> **%3$@** -> **%4$@** を追加して確認"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ -> **%2$@** -> **%3$@** -> **%4$@**를 추가하고 확인"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ -> **%2$@** -> **%3$@** -> добавьте **%4$@** и проверьте"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ -> **%2$@** -> **%3$@** -> 添加 **%4$@** 并检查"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ -> **%2$@** -> **%3$@** -> 新增 **%4$@** 並檢查"
          }
