    "Key combinations such as A, K, Shift+A, ⌘+C are aggregated for the selected range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastenkombinationen wie A, K, Umschalt+A und ⌘+C werden für den ausgewählten Zeitraum zusammengefasst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les combinaisons de touches telles que A, K, Maj+A et ⌘+C sont regroupées pour la période sélectionnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le combinazioni di tasti come A, K, Maiusc+A e ⌘+C vengono aggregate per l’intervallo selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
