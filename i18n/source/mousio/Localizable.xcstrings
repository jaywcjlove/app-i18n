    "You can assign %@ function keys to activate Hint mode with a single press." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst %@ Funktionstasten zuweisen, um den Hinweismodus mit einem einzigen Druck zu aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
