          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ la touche %2$@ pour entrer en mode souris au clavier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ il tasto %2$@ per entrare nella modalità mouse da tastiera."
