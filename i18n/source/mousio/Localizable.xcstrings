    "You have granted the app Accessibility permission, enabling the ability to listen for shortcuts and move the mouse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast der App die Berechtigung für Bedienungshilfen erteilt, sodass Kurzbefehle abgehört und die Maus bewegt werden können."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
