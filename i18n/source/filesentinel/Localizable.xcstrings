    "Only the folder record and access authorization will be removed, and the original files will not be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur der Ordnerdatensatz und die Zugriffsberechtigung entfernt; die Originaldateien werden nicht gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls l'enregistrement du dossier et l'autorisation d'accès seront supprimés, les fichiers d'origine ne seront pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi solo il record della cartella e l'autorizzazione di accesso; i file originali non verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ記録とアクセス認証のみが削除され、元のファイルは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더 기록과 접근 권한만 제거되며, 원본 파일은 삭제되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет удалена только запись о папке и авторизация доступа, исходные файлы не будут удалены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅删除文件夹记录和访问授权，原始文件不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅刪除檔案夾記錄和存取授權，原始檔案不會被刪除。"
          }
        }
      }
    },
    "Only the folder record and its access permission will be removed, the original files will not be deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Ordnereintrag und seine Zugriffsberechtigung werden entfernt, die Originaldateien werden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the folder record and its access permission will be removed, the original files will not be deleted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul l'enregistrement du dossier et son autorisation d'accès seront supprimés, les fichiers originaux ne seront pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi solo il record della cartella e il relativo permesso di accesso; i file originali non verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ記録とそのアクセス権限のみが削除され、元のファイルは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더 기록과 접근 권한만 제거되며, 원본 파일은 삭제되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет удалена только запись о папке и её разрешения доступа, исходные файлы не будут удалены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
