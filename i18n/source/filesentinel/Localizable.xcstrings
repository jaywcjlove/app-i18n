    "Enabling this feature will deduplicate data in history and insert new items" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Aktivieren dieser Funktion werden doppelte Daten im Verlauf dedupliziert und neue Einträge eingefügt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'activation de cette fonction dédupliquera les données de l'historique et insérera de nouveaux éléments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitando questa funzione, i dati nella cronologia verranno deduplicati e verranno inseriti nuovi elementi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この機能を有効にすると、履歴内のデータが重複排除され、新しいアイテムが挿入されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기능을 활성화하면 기록에서 중복 데이터가 제거되고 새 항목이 삽입됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включение этой функции удалит дублирующиеся данные в истории и вставит новые элементы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用此功能将对历史记录中的数据进行去重并插入新条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用此功能將對歷史記錄中的資料進行去重並插入新條目。"
          }
        }
      }
    },
    "Enabling this feature will remove duplicate data from the history and insert a new entry." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
