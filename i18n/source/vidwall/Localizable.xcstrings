    "Display a website or local HTML file on top of the video wallpaper. Pages with a transparent background will show the video underneath." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigen Sie eine Website oder eine lokale HTML-Datei über dem Video-Hintergrundbild an. Seiten mit transparentem Hintergrund lassen das Video darunter sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display a website or local HTML file on top of the video wallpaper. Pages with a transparent background will show the video underneath."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez un site web ou un fichier HTML local au-dessus du fond d'écran vidéo. Les pages à fond transparent laissent voir la vidéo en dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un sito web o un file HTML locale sopra lo sfondo video. Le pagine con sfondo trasparente mostrano il video sottostante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画壁紙の上にウェブサイトまたはローカル HTML ファイルを表示します。背景が透明なページでは下の動画が見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상 배경화면 위에 웹사이트 또는 로컬 HTML 파일을 표시합니다. 배경이 투명한 페이지는 아래 동영상이 보입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображайте сайт или локальный HTML-файл поверх видеообоев. Страницы с прозрачным фоном показывают видео под ними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在视频壁纸之上显示网站或本地 HTML 文件。背景透明的页面会透出下方的视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在影片桌布之上顯示網站或本機 HTML 檔案。背景透明的頁面會透出下方的影片。"
          }
        }
      }
    },
