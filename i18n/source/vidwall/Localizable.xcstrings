    "Only the folder record and its access permission will be removed. The original files will not be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Ordnereintrag und seine Zugriffsberechtigung werden entfernt. Die Originaldateien werden nicht gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul l'enregistrement du dossier et son autorisation d'accès seront supprimés. Les fichiers d'origine ne seront pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi solo il record della cartella e il suo permesso di accesso. I file originali non verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダの記録とそのアクセス権限のみ削除されます。元のファイルは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더 기록과 해당 접근 권한만 제거됩니다. 원본 파일은 삭제되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены только запись папки и разрешение на доступ к ней. Исходные файлы удалены не будут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅会移除文件夹记录及其访问权限，原文件不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅會移除資料夾紀錄及其存取權限，原始檔案不會被刪除。"
          }
        }
      }
    },
    "Only the folder record and permissions will be removed; files remain intact." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Ordnereintrag und die Berechtigungen werden entfernt; die Dateien bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls l'enregistrement du dossier et les autorisations seront supprimés ; les fichiers restent intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi solo il record della cartella e i permessi; i file resteranno intatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダの記録と権限のみ削除され、ファイルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더 기록과 권한만 제거되며, 파일은 그대로 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены только запись папки и разрешения; файлы останутся нетронутыми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅删除文件夹记录和权限，文件不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅會移除資料夾紀錄與權限，檔案將保持不變。"
          }
        }
      }
    },
