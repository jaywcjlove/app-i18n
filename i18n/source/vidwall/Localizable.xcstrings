    "Camera wallpaper needs camera access. Click Authorize to grant permission, or open System Settings from the General page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kamera-Hintergrundbild benötigt Kamerazugriff. Klicken Sie auf „Autorisieren“, um die Berechtigung zu erteilen, oder öffnen Sie die Systemeinstellungen über die Seite „Allgemein“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fond d'écran caméra nécessite l'accès à la caméra. Cliquez sur « Autoriser » pour accorder l'autorisation, ou ouvrez les Réglages Système depuis la page Général."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sfondo con fotocamera richiede l'accesso alla fotocamera. Clicca su Autorizza per concedere il permesso oppure apri Impostazioni di sistema dalla pagina Generale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラ壁紙にはカメラへのアクセスが必要です。「許可」を押して権限を付与するか、「一般」ページからシステム設定を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 배경화면을 사용하려면 카메라 접근 권한이 필요합니다. “승인”을 눌러 권한을 허용하거나, 일반 페이지에서 시스템 설정을 여세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обоев с камеры нужен доступ к камере. Нажмите «Разрешить», чтобы предоставить доступ, или откройте Системные настройки на странице «Основные»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用摄像头作为桌面壁纸需要摄像头权限。点击「授权」以允许访问，也可在「常规」设置页中打开系统设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用攝影機作為桌面桌布需要攝影機權限。點擊「授權」以允許存取，也可在「一般」設定頁中開啟系統設定。"
          }
        }
      }
    },
