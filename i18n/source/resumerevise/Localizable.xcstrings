    "List all resumes saved in Resume Revise. Returns id, name, job title, and template path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listet alle in Resume Revise gespeicherten Lebensläufe auf. Gibt ID, Name, Stellenbezeichnung und Vorlagenpfad zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste tous les CV enregistrés dans Resume Revise. Renvoie l'identifiant, le nom, l'intitulé du poste et le chemin du modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenca tutti i curriculum salvati in Resume Revise. Restituisce id, nome, titolo di lavoro e percorso del modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume Revise に保存されたすべての職務経歴書を一覧表示します。ID、名前、職種、テンプレートパスを返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume Revise에 저장된 모든 이력서를 목록으로 표시합니다. ID, 이름, 직무, 템플릿 경로를 반환합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выводит список всех резюме, сохранённых в Resume Revise. Возвращает идентификатор, имя, должность и путь к шаблону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出 Resume Revise 中保存的所有简历，返回 ID、名称、职位名称和模板路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出 Resume Revise 中儲存的所有履歷，回傳 ID、名稱、職務名稱和模板路徑。"
          }
        }
      }
    },
