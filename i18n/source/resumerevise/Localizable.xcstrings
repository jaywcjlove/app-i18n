    "Add Resume Revise in Grok with this command, or paste the TOML into ~/.grok/config.toml." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Resume Revise mit diesem Befehl in Grok hinzu oder fügen Sie das TOML in ~/.grok/config.toml ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez Resume Revise dans Grok avec cette commande, ou collez le TOML dans ~/.grok/config.toml."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi Resume Revise in Grok con questo comando, oppure incolla il TOML in ~/.grok/config.toml."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコマンドで Grok に Resume Revise を追加するか、TOML を ~/.grok/config.toml に貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 명령어로 Grok에 Resume Revise를 추가하거나, TOML을 ~/.grok/config.toml에 붙여넣으세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте Resume Revise в Grok этой командой или вставьте TOML в ~/.grok/config.toml."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此命令在 Grok 中添加 Resume Revise，或将 TOML 粘贴到 ~/.grok/config.toml 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此指令在 Grok 中新增 Resume Revise，或將 TOML 貼到 ~/.grok/config.toml 中。"
          }
        }
