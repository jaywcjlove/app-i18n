        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전공 내용을 자세히 설명하세요. 커리큘럼, 졸업 프로젝트 등을 포함합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подробно опишите свою специальность, включая изучаемые дисциплины, выпускной проект и т. д."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
