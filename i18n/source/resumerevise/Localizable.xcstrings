    "Describe your major in detail, including curriculums and graduation project,etc." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreiben Sie Ihr Studienfach im Detail, einschließlich der besuchten Kurse, der Abschlussarbeit usw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez votre spécialité en détail, y compris les cours suivis, le projet de fin d'études, etc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi in dettaglio il tuo corso di studi, inclusi gli esami seguiti, la tesi di laurea, ecc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "専攻の内容を詳しく記入してください。カリキュラムや卒業研究などを含みます。"
