    "A brief introduction of yourself. Just show your biggest advantages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie sich kurz vor und heben Sie Ihre größten Stärken hervor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Présentez-vous brièvement et mettez en valeur vos atouts majeurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presentati brevemente e metti in risalto i tuoi punti di forza principali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分について簡単に紹介し、最大の強みをアピールしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자신을 간략히 소개하고 가장 큰 강점을 어필하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кратко представьтесь и покажите свои сильнейшие стороны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "介绍自己，说明自己的最大优势，让企业看到你的闪光点"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "介紹自己，說明自己的最大優勢，讓企業看到你的亮點。"
          }
        }
      }
    },
