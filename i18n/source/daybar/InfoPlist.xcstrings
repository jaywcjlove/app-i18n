    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar benötigt Zugriff, um die Kalender-App am ausgewählten Datum zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DayBar needs access to open Calendar app at the selected date."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar a besoin d'un accès pour ouvrir l'app Calendrier à la date sélectionnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar necessita dell'accesso per aprire l'app Calendario alla data selezionata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar が選択した日付でカレンダーアプリを開くにはアクセス権が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar가 선택한 날짜로 캘린더 앱을 열려면 접근 권한이 필요합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar требуется доступ, чтобы открывать приложение «Календарь» на выбранной дате."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar 需要访问权限才能在所选日期打开日历应用程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar 需要存取權限，才能在選定日期開啟行事曆 App。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar benötigt Zugriff, um Ereignisse aus deinen Kalendern anzuzeigen."
