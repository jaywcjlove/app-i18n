        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayBar があなたのカレンダーのイベントを表示するにはアクセス権が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
