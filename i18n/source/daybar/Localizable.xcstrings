      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgrund von Einschränkungen der Erinnerungen-App können Daten nur innerhalb der App gelöscht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En raison des limitations de l'app Rappels, les données ne peuvent être effacées que dans l'application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A causa delle limitazioni dell'app Promemoria, i dati possono essere cancellati solo all'interno dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーアプリの制限により、データの消去はアプリ内でのみ実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 알림 앱의 제한으로 인해 데이터는 앱 내에서만 지울 수 있습니다."
