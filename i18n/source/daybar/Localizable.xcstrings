        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访问您的日历将使应用程序能够访问所有关联的元数据。选择对整个日历的完全访问权限，或仅添加访问权限。"
          }
        },
