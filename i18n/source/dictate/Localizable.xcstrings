    " Compressed package with lower disk and memory use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komprimiertes Paket mit geringerer Festplatten- und Speichernutzung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package compressé avec une utilisation réduite du disque et de la mémoire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクとメモリ使用量が少ない圧縮パッケージ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축 패키지, 디스크 및 메모리 사용량이 더 낮습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
