    "This list is provided by WhisperKit for the current Mac. If the remote catalog cannot load, the app falls back to WhisperKit's local recommendations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Liste wird von WhisperKit für den aktuellen Mac bereitgestellt. Wenn der Remote-Katalog nicht geladen werden kann, greift die App auf die lokalen Empfehlungen von WhisperKit zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste est fournie par WhisperKit pour le Mac actuel. Si le catalogue distant ne peut pas être chargé, l'application utilise les recommandations locales de WhisperKit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリストは現在のMac向けにWhisperKitが提供しています。リモートカタログを読み込めない場合、アプリはWhisperKitのローカル推奨にフォールバックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 목록은 현재 Mac에 대해 WhisperKit에서 제공합니다. 원격 카탈로그를 로드할 수 없는 경우 앱은 WhisperKit의 로컬 권장 사항으로 대체됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此列表由 WhisperKit 针对当前 Mac 提供。若远程目录加载失败，应用将回退到 WhisperKit 的本地推荐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此列表由 WhisperKit 針對目前 Mac 提供。若遠端目錄載入失敗，應用將回退到 WhisperKit 的本機推薦。"
          }
        }
      }
    },
