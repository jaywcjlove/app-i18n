    "After granting permissions in System Settings, return to Dictate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem Sie die Berechtigungen in den Systemeinstellungen erteilt haben, kehren Sie zu Dictate zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir accordé les autorisations dans Réglages Système, revenez à Dictate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で権限を許可した後、Dictateに戻ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 권한을 허용한 후 Dictate로 돌아오세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在系统设置中完成授权后，返回 Dictate。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在系統設定中完成授權後，返回 Dictate。"
          }
        }
      }
    },
    "Allows Dictate to detect the dictation shortcut globally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht Dictate, das Diktierkürzel global zu erkennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Dictate de détecter le raccourci de dictée globalement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictateがディクテーションショートカットをグローバルに検出できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate가 전역에서 받아쓰기 단축키를 감지할 수 있도록 허용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 在全局检测听写快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 Dictate 在全域偵測聽寫快捷鍵。"
          }
        }
      }
    },
    "Allows Dictate to insert recognized text at the active cursor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht Dictate, erkannten Text am aktiven Cursor einzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Dictate d'insérer le texte reconnu au niveau du curseur actif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictateが認識したテキストをアクティブなカーソル位置に挿入できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate가 활성 커서 위치에 인식된 텍스트를 삽입할 수 있도록 허용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 将识别结果插入当前光标位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 Dictate 將識別結果插入目前游標位置。"
          }
        }
      }
    },
    "Allows Dictate to record audio locally for speech recognition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht Dictate, Audio lokal für die Spracherkennung aufzunehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Dictate d'enregistrer l'audio localement pour la reconnaissance vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictateが音声認識のためにローカルでオーディオを録音できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate가 음성 인식을 위해 로컬에서 오디오를 녹음할 수 있도록 허용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 在本地录制音频用于语音识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 Dictate 在本機錄製音訊用於語音辨識。"
          }
        }
      }
    },
