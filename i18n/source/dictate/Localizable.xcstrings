    "Press and hold the selected key until the delay passes to start dictation. Release it to transcribe and insert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die ausgewählte Taste gedrückt, bis die Verzögerung abgelaufen ist, um das Diktat zu starten. Lassen Sie sie los, um zu transkribieren und einzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez la touche sélectionnée enfoncée jusqu'à ce que le délai soit écoulé pour démarrer la dictée. Relâchez-la pour transcrire et insérer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅延時間が経過するまで選択したキーを長押ししてディクテーションを開始します。離すと文字起こしして挿入します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지연 시간이 지날 때까지 선택한 키를 길게 눌러 받아쓰기를 시작하세요. 놓으면 전사하여 삽입됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住所选按键直到延迟时间结束后开始听写，松开后转写并插入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住所選按鍵直到延遲時間結束後開始聽寫，放開後轉寫並插入。"
          }
        }
      }
    },
