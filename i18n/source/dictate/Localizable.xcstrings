    "Distilled large model, usually faster than full large models while keeping strong accuracy.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grand modèle distillé, généralement plus rapide que les grands modèles complets tout en conservant une forte précision."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蒸留大規模モデル。通常、完全な大規模モデルよりも高速で、高い精度を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "증류 대형 모델, 일반적으로 전체 대형 모델보다 빠르면서 높은 정확도를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蒸馏大模型，通常比完整大模型更快，同时保持高准确率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蒸餾大模型，通常比完整大模型更快，同時保持高準確率。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Destilliertes großes Modell, normalerweise schneller als vollständige große Modelle bei gleichbleibend hoher Genauigkeit."
          }
        }
      }
    },
