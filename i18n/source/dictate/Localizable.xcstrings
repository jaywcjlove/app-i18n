    " Turbo variant with lower latency.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Variante Turbo avec une latence réduite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低遅延のTurboバリアント。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 낮은 지연 시간의 Turbo 변형."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
