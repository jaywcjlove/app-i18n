  "strings" : {
    " Compressed package with lower disk and memory use." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축 패키지, 디스크 및 메모리 사용량이 더 낮습니다."
