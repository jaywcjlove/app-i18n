    "After granting permissions in System Settings, return to Dictate." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 권한을 허용한 후 Dictate로 돌아오세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在系统设置中完成授权后，返回 Dictate。"
          }
        }
      }
    },
    "Allows Dictate to detect the dictation shortcut globally." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate가 전역에서 받아쓰기 단축키를 감지할 수 있도록 허용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 在全局检测听写快捷键。"
          }
        }
      }
    },
    "Allows Dictate to insert recognized text at the active cursor." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate가 활성 커서 위치에 인식된 텍스트를 삽입할 수 있도록 허용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 将识别结果插入当前光标位置。"
          }
        }
      }
    },
    "Allows Dictate to record audio locally for speech recognition." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate가 음성 인식을 위해 로컬에서 오디오를 녹음할 수 있도록 허용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 在本地录制音频用于语音识别。"
          }
        }
      }
    },
