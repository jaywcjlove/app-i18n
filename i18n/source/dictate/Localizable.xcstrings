    "Microphone, Input Monitoring, and Accessibility permissions are needed for shortcut detection, local capture, and cursor insertion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungen für Mikrofon, Eingabeüberwachung und Bedienungshilfen werden für die Tastenkürzelerkennung, lokale Aufnahme und Cursor-Einfügung benötigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations Microphone, Surveillance des entrées et Accessibilité sont nécessaires pour la détection des raccourcis, la capture locale et l'insertion au curseur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカット検出、ローカルキャプチャ、カーソル挿入には、マイク、入力監視、アクセシビリティの権限が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 감지, 로컬 캡처 및 커서 삽입을 위해 마이크, 입력 모니터링 및 접근성 권한이 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要麦克风、输入监控和辅助功能权限，才能检测快捷键、本地采集语音并在光标处插入文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要麥克風、輸入監控與輔助功能權限，才能偵測快捷鍵、本機擷取語音並在游標處插入文字。"
          }
        }
      }
    },
