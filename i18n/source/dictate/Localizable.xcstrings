    "Dictate needs Accessibility, Input Monitoring, and Microphone permissions before it can listen and insert text.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate a besoin des autorisations Accessibilité, Surveillance des entrées et Microphone avant de pouvoir écouter et insérer du texte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictateが音声を聞き取ってテキストを挿入するには、アクセシビリティ、入力監視、マイクの権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate가 음성을 듣고 텍스트를 삽입하려면 접근성, 입력 모니터링 및 마이크 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先授权辅助功能、输入监控和麦克风，Dictate 才能聆听并插入文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先授權輔助功能、輸入監控與麥克風，Dictate 才能聆聽並插入文字。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate benötigt Berechtigungen für Bedienungshilfen, Eingabeüberwachung und Mikrofon, bevor es zuhören und Text einfügen kann."
          }
        }
      }
    },
    "Dictation shortcut": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourci de dictée"
          }
        },
