{
  "sourceLanguage" : "en",
  "strings" : {
    "Accessibility" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助功能"
          }
        }
      }
    },
    "Allows Dictate to capture your voice locally for speech recognition. Audio is not uploaded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 在本地采集你的语音用于识别。音频不会上传。"
          }
        }
      }
    },
    "Allows Dictate to detect the selected hold-to-dictate shortcut while you are using other apps." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 在你使用其他应用时检测所选的按住听写快捷键。"
          }
        }
      }
    },
    "Allows Dictate to insert recognized text into the app and text field currently focused by the cursor." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Dictate 将识别文本插入到当前光标聚焦的应用与文本输入框中。"
          }
        }
      }
    },
    "Audio never leaves this Mac" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频绝不会离开这台 Mac"
