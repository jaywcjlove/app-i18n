    "Unlock all features permanently with a one-time payment and enjoy all future upgrades for free—no additional fees ever.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez toutes les fonctionnalités de façon permanente avec un paiement unique et profitez gratuitement de toutes les futures mises à niveau — sans frais supplémentaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の支払いですべての機能を永続的にロック解除し、将来のすべてのアップグレードを無料でご利用いただけます。追加料金は一切ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회성 결제로 모든 기능을 영구적으로 잠금 해제하고 향후 모든 업그레이드를 무료로 이용하세요. 추가 비용은 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付费永久解锁所有功能，免费享受未来所有升级——无需额外付费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付費永久解鎖所有功能，免費享受未來所有升級——無需額外付費。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie alle Funktionen dauerhaft mit einer einmaligen Zahlung frei und genießen Sie alle zukünftigen Upgrades kostenlos – ohne weitere Gebühren."
          }
        }
      }
    },
