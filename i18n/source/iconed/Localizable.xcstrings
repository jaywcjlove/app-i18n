    "When converting images to .jpeg, you can set the quality of the converted image here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Konvertieren von Bildern in .jpeg können Sie hier die Qualität des konvertierten Bildes festlegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de la conversion d’images en .jpeg, vous pouvez définir ici la qualité de l’image convertie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando converti le immagini in .jpeg, puoi impostare qui la qualità dell’immagine convertita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を .jpeg に変換する際、ここで変換後の画質を設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 .jpeg로 변환할 때 여기서 변환된 이미지의 품질을 설정할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При конвертации изображений в .jpeg здесь можно задать качество преобразованного изображения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将图像转换为 .jpeg 时，您可以在此处设置转换图像的质量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將影像轉換為 .jpeg 時，您可以在此設定轉換後影像的品質。"
          }
        }
      }
    },
    "You can only drag one icon, and it’s best to use a 1024x1024 size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können nur ein Symbol ziehen; am besten eignet sich die Größe 1024×1024."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez faire glisser qu’une seule icône ; il est préférable d’utiliser une taille de 1024×1024."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi trascinare una sola icona; è consigliabile usare una dimensione di 1024×1024."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグできるアイコンは1つだけです。1024×1024 サイズの使用をおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이콘은 하나만 드래그할 수 있으며, 1024×1024 크기를 사용하는 것이 좋습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно перетащить только один значок; рекомендуется использовать размер 1024×1024."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你只能拖拽一个图标，建议使用 1024x1024 的尺寸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您只能拖放一個圖示，建議使用 1024×1024 的尺寸。"
          }
        }
      }
    },
    "You need to add an image, preferably with a size of 1024x1024." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie müssen ein Bild hinzufügen, idealerweise mit der Größe 1024×1024."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devez ajouter une image, de préférence d’une taille de 1024×1024."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devi aggiungere un’immagine, preferibilmente di dimensioni 1024×1024."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を追加する必要があります。1024×1024 サイズがおすすめです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 추가해야 합니다. 가능하면 1024×1024 크기를 사용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необходимо добавить изображение, предпочтительно размером 1024×1024."
          }
        },
        "zh-Hans" : {
