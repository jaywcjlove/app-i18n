    "Click on the icon in the \"%@ Info\" dialog and press the delete key on your keyboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie im Dialog „%@ Informationen“ auf das Symbol und drücken Sie die Rücktaste auf Ihrer Tastatur."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur l’icône dans la fenêtre « Informations sur %@ », puis appuyez sur la touche de suppression de votre clavier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic sull’icona nella finestra “Informazioni su %@” e premi il tasto Cancella sulla tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@ の情報」ダイアログ内のアイコンをクリックし、キーボードの delete キーを押します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@ 정보” 대화상자에서 아이콘을 클릭한 다음 키보드의 delete 키를 누르세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на значок в окне «Свойства: %@» и нажмите клавишу Delete на клавиатуре."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
