    "Drag and drop an image into the window to add a test background image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie ein Bild per Drag-and-drop in das Fenster, um ein Test-Hintergrundbild hinzuzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez-déposez une image dans la fenêtre pour ajouter une image d’arrière-plan de test."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un'immagine nella finestra per aggiungere un'immagine di sfondo per il test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像をウインドウにドラッグ＆ドロップすると、テスト用背景画像として追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 창으로 드래그 앤 드롭하여 테스트 배경 이미지를 추가하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите изображение в окно, чтобы добавить тестовое фоновое изображение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将图片拖拽到窗口添加测试背景图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將圖片拖放到視窗中以加入測試背景圖片。"
          }
        }
      }
    },
    "Fill the screen with any solid color to check dead pixels, tint, or backlight issues." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt den Bildschirm mit einer beliebigen Vollfarbe, um Pixelfehler, Farbstiche oder Probleme mit der Hintergrundbeleuchtung zu prüfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplissez l’écran avec une couleur unie pour vérifier les pixels morts, une dominante de couleur ou des problèmes de rétroéclairage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riempi lo schermo con un colore uniforme per controllare pixel difettosi, dominanti di colore o problemi di retroilluminazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面を単色で塗りつぶして、ドット欠け、色かぶり、バックライトの問題を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면을 단색으로 채워 불량 화소, 색 번짐, 백라이트 문제를 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заполните экран любым сплошным цветом, чтобы проверить битые пиксели, цветовой оттенок или проблемы с подсветкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全屏显示任意纯色，用于检查坏点、色偏或背光问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全螢幕顯示任意純色，用於檢查壞點、色偏或背光問題。"
          }
        }
      }
    },
