    "Space to pause · Higher Hz → smoother bar · software estimate, not a lab meter" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leertaste zum Pausieren · Höhere Hz → flüssigerer Balken · Software-Schätzung, kein Labormessgerät"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace pour mettre en pause · Hz plus élevé → barre plus fluide · estimation logicielle, pas un instrument de laboratoire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio per pausa · Hz più alti → barra più fluida · stima software, non uno strumento da laboratorio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceで一時停止 · Hzが高いほど→バーは滑らか · ソフトウェア推定値であり、計測器ではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space로 일시 정지 · Hz가 높을수록 → 바가 더 부드러움 · 실험실 계측기가 아닌 소프트웨어 추정치"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space для паузы · Чем выше Hz → тем плавнее полоса · программная оценка, не лабораторный прибор"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空格暂停 · 刷新率越高扫描条越平滑 · 软件估算，非仪器测量"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空白鍵暫停 · Hz 越高 → 掃描條越平滑 · 軟體估算，非實驗室儀表"
          }
        }
      }
    },
