    "Motion Blur" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegungsunschärfe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flou de mouvement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfocatura di movimento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーションブラー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모션 블러"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размытие в движении"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动拖影"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動態拖影"
          }
        }
      }
    },
    "Moving high-contrast shapes reveal motion blur and ghosting; faster panels keep edges sharper." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegte kontrastreiche Formen machen Bewegungsunschärfe und Nachbilder sichtbar; schnellere Panels halten Kanten schärfer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des formes contrastées en mouvement révèlent le flou de mouvement et les rémanences ; les dalles plus rapides conservent des contours plus nets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le forme in movimento ad alto contrasto rivelano sfocatura di movimento e ghosting; i pannelli più rapidi mantengono i bordi più nitidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高コントラストの移動図形でモーションブラーや残像を確認します。応答の速いパネルほど輪郭がシャープに見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고대비의 움직이는 도형으로 모션 블러와 잔상을 확인할 수 있습니다. 더 빠른 패널일수록 가장자리가 더 선명하게 보입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движущиеся контрастные фигуры помогают выявить размытие в движении и шлейфы; на более быстрых панелях края остаются четче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高对比移动图形用于观察运动模糊与拖影；响应更快的屏幕边缘更清晰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高對比移動圖形用於觀察動態模糊與殘影；反應更快的螢幕邊緣更清晰。"
          }
        }
      }
    },
    "Multi-size text and 1px guides for sharpness, scaling, and subpixel checks — pairs with the Sharpness watermark test." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text in mehreren Größen und 1px-Hilfslinien für Schärfe-, Skalierungs- und Subpixel-Prüfungen; passt zum Schärfe-Wasserzeichentest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte en plusieurs tailles et guides 1 px pour vérifier la netteté, la mise à l’échelle et les sous-pixels — s’associe au test de filigrane de netteté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo di più dimensioni e guide da 1 px per controllare nitidezza, ridimensionamento e subpixel — si abbina al test watermark della nitidezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数サイズの文字と 1px ガイドで、シャープネス、スケーリング、サブピクセルを確認します。シャープネスの透かしテストと組み合わせて使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 크기의 텍스트와 1px 가이드로 선명도, 스케일링, 서브픽셀을 확인합니다. 선명도 워터마크 테스트와 함께 사용할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст разных размеров и направляющие 1 px для проверки резкости, масштабирования и субпикселей — хорошо сочетается с тестом водяного знака резкости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多字号文字与 1px 参考线，用于清晰度、缩放与子像素检查，可与清晰度水印测试配合使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多字號文字與 1px 參考線，用於清晰度、縮放與子像素檢查，可與清晰度浮水印測試搭配使用。"
          }
        }
      }
    },
