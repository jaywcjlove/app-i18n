    "NSInputMonitoringUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir benötigen Zugriff auf Ihr Maus-Eingabegerät, um Effekte basierend auf der Mausklick-Position auszulösen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need access to your mouse input device to trigger effects based on the mouse click position."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons besoin d'accéder à votre périphérique de saisie souris pour déclencher des effets basés sur la position du clic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo bisogno di accedere al dispositivo di input del mouse per attivare effetti in base alla posizione del clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスクリック位置に基づいてエフェクトをトリガーするために、マウス入力デバイスへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 클릭 위치에 따라 효과를 실행하려면 마우스 입력 장치에 접근해야 합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нам нужен доступ к вашему устройству ввода мыши для запуска эффектов в зависимости от позиции щелчка мыши."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们需要访问您的鼠标输入设备，以便根据鼠标点击位置触发特效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們需要存取您的滑鼠輸入裝置，以便根據滑鼠點擊位置觸發特效。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}