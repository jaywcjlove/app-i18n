    "You can press the %@ key to exit drawing board mode, or %@ to open the context menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke die Taste %1$@, um den Zeichenbrett-Modus zu verlassen, oder %2$@, um das Kontextmenü zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can press the %1$@ key to exit drawing board mode, or %2$@ to open the context menu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez appuyer sur la touche %1$@ pour quitter le mode tableau de dessin, ou %2$@ pour ouvrir le menu contextuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi il tasto %1$@ per uscire dalla modalità tavolo da disegno, o %2$@ per aprire il menu contestuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@キーを押すと描画ボードモードを終了し、%2$@でコンテキストメニューを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 키를 눌러 그리기 보드 모드를 종료하거나, %2$@ 키로 컨텍스트 메뉴를 열 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете нажать клавишу %1$@ для выхода из режима доски или %2$@ для открытия контекстного меню."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以按 %1$@ 键退出绘图板模式，或按 %2$@ 打开上下文菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以按下 %1$@ 鍵退出繪圖板模式，或按 %2$@ 開啟右鍵選單。"
          }
        }
      }
    },
    "You need to enable input monitoring permissions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst die Eingabeüberwachungsberechtigungen aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devez activer les autorisations de surveillance des entrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devi abilitare i permessi di monitoraggio input."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力監視の許可を有効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력 모니터링 권한을 활성화해야 합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вам необходимо включить разрешения мониторинга ввода."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要启用输入监控权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您需要啟用輸入監控權限。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}