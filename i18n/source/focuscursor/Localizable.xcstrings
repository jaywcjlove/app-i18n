    "+X is right of the cursor tip, +Y is above. Layer Offset stacks on top in Custom mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X ist rechts von der Cursorspitze, +Y ist oben. Ebenenversatz wird im benutzerdefinierten Modus obenauf gestapelt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X est à droite du curseur, +Y est au-dessus. Le décalage de calque s'empile par-dessus en mode personnalisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X è a destra del cursore, +Y è in alto. Lo scostamento del livello si sovrappone in modalità personalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Xはカーソル先端の右側、+Yは上方向です。カスタムモードではレイヤーオフセットが上に重なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X는 커서 끝의 오른쪽, +Y는 위쪽입니다. 사용자 정의 모드에서는 레이어 오프셋이 위에 쌓입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X справа от кончика курсора, +Y сверху. Смещение слоя накладывается поверх в пользовательском режиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X 在光标尖端的右侧，+Y 在上方。自定义模式下图层偏移叠加在上面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X 在游標尖端的右側，+Y 在上方。自訂模式下圖層偏移疊加在上面。"
          }
        }
      }
    },
    "+Y is up in Core Animation. Use negative Y for gravity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y ist oben in Core Animation. Verwende negatives Y für Schwerkraft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y est en haut dans Core Animation. Utilisez Y négatif pour la gravité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y è in alto in Core Animation. Usa Y negativo per la gravità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+YはCore Animationで上方向です。重力には負のYを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y는 Core Animation에서 위쪽입니다. 중력에는 음수 Y를 사용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y направлен вверх в Core Animation. Используйте отрицательный Y для гравитации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y 在 Core Animation 中为上方。使用负 Y 值模拟重力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y 在 Core Animation 中是上方。重力請使用負 Y 值。"
          }
        }
      }
    },
