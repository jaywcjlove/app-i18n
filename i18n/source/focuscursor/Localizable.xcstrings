          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les outils de dessin, les couleurs et la largeur du trait sont configurés dans la barre d'outils du tableau de dessin à l'écran, propulsée par ScapDrawingKit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strumenti di disegno, colori e larghezza tratto sono configurati nella barra degli strumenti del tavolo da disegno a schermo, basata su ScapDrawingKit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
