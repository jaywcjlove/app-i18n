    "+X is right of the cursor tip, +Y is above. Layer Offset stacks on top in Custom mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X ist rechts von der Cursorspitze, +Y ist oben. Ebenenversatz wird im benutzerdefinierten Modus obenauf gestapelt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+X 在光标尖端的右侧，+Y 在上方。自定义模式下图层偏移叠加在上面。"
          }
        }
      }
    },
    "+Y is up in Core Animation. Use negative Y for gravity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y ist oben in Core Animation. Verwende negatives Y für Schwerkraft."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+Y 在 Core Animation 中为上方。使用负 Y 值模拟重力。"
          }
        }
      }
    },
