    "To enable mouse position tracking and display, please grant the app mouse input monitoring permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Mauspositionsverfolgung und -anzeige zu aktivieren, gewähre bitte der App die Erlaubnis zur Mauseingabe-Überwachung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour activer le suivi et l'affichage de la position de la souris, veuillez autoriser l'autorisation de surveillance des entrées souris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per abilitare il tracciamento e la visualizzazione della posizione del mouse, concedi all'app l'autorizzazione di monitoraggio input mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウス位置の追跡と表示を有効にするには、アプリにマウス入力監視の許可を与えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 위치 추적 및 표시를 활성화하려면 앱에 마우스 입력 모니터링 권한을 허용해 주세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы включить отслеживание и отображение позиции мыши, предоставьте приложению разрешение на мониторинг ввода мыши."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为启用鼠标位置跟踪和显示，需要授予应用鼠标输入监控权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要啟用滑鼠位置追蹤與顯示，請授予應用程式滑鼠輸入監控權限。"
          }
        }
      }
    },
