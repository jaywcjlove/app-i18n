    "Drag a ZIP, TAR, TAR.GZ, or TGZ archive into the window, or open an existing archive from the toolbar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 ZIP、TAR、TAR.GZ 或 TGZ 压缩包拖入窗口，或从工具栏打开已有压缩包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 ZIP、TAR、TAR.GZ 或 TGZ 封存檔拖曳到視窗中，或從工具列開啟現有封存檔。"
          }
        }
      }
    },
    "Drop an archive to preview or extract it, or drop multiple files and folders to create a new archive." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖入压缩包可预览或解压；拖入多个文件和文件夹可创建新的压缩包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖放封存檔可預覽或解壓，或拖放多個檔案與資料夾以建立新的封存檔。"
          }
        }
      }
    },
