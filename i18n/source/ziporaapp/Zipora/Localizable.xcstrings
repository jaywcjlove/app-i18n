    },
    "\"%@\" requires a password before it can be extracted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”在解压前需要输入密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在解壓前需要輸入密碼。"
          }
        }
      }
    },
    "\"%@\" requires a password before it can be opened." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”在打开前需要输入密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在開啟前需要輸入密碼。"
          }
        }
      }
    },
    "1. Open [System Settings](systemSettings)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 打开[系统设置](systemSettings)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 開啟[系統設定](systemSettings)。"
          }
        }
      }
    },
    "2. Scroll down to the \"Extensions\" section and click the info button in \"Folder Preview\"." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 向下滚动到“扩展”部分，然后点击“文件夹预览”中的信息按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 向下捲動到「擴充功能」區段，然後點擊「資料夾預覽」中的資訊按鈕。"
          }
        }
      }
    },
    "3. Select \"Folder Preview\" extension." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 选择“文件夹预览”扩展。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 選擇「資料夾預覽」擴充功能。"
          }
        }
      }
    },
    "4. Select \"Archive Preview\" if you want to preview archive files like .zip, .7z, and .rar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. 如果你想预览 .zip、.7z、.rar 等压缩文件，请选择“压缩包预览”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. 如果你想預覽 .zip、.7z、.rar 等壓縮檔，請選擇「壓縮檔預覽」。"
          }
        }
      }
    },
