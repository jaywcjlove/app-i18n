    "The new password cannot be the same as the old one. Please enter a different password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das neue Passwort darf nicht mit dem alten übereinstimmen. Bitte geben Sie ein anderes Passwort ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nouveau mot de passe ne peut pas être identique à l’ancien. Veuillez en saisir un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuova password non può essere uguale a quella precedente. Inserisci una password diversa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいパスワードは古いパスワードと同じにできません。別のパスワードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 비밀번호는 이전 비밀번호와 같을 수 없습니다. 다른 비밀번호를 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый пароль не может совпадать со старым. Введите другой пароль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新密码不能与旧密码相同，请输入一个不同的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新密碼不能與舊密碼相同，請輸入不同的密碼。"
          }
        }
      }
    },
    "The password file cannot be accessed. Please re-add the file to automatically grant read and write permissions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf die Passwortdatei kann nicht zugegriffen werden. Bitte fügen Sie die Datei erneut hinzu, um Lese- und Schreibrechte automatisch zu erteilen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de mots de passe est inaccessible. Veuillez le rajouter pour accorder automatiquement les autorisations de lecture et d’écriture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile accedere al file password. Aggiungi di nuovo il file per concedere automaticamente i permessi di lettura e scrittura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードファイルにアクセスできません。ファイルを再度追加して、読み取りと書き込みの権限を自動的に付与してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호 파일에 접근할 수 없습니다. 파일을 다시 추가하여 읽기 및 쓰기 권한을 자동으로 부여하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет доступа к файлу паролей. Добавьте файл снова, чтобы автоматически предоставить права на чтение и запись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码文件无权限访问，请重新添加文件以自动授权读写权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法存取密碼檔案。請重新加入檔案以自動授予讀寫權限。"
          }
        }
      }
    },
