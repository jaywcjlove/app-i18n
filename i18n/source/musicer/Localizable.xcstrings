    "Limit the depth of recursive directory scanning to avoid performance issues caused by deeply nested folders." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitez la profondeur de l’analyse récursive des dossiers afin d’éviter les problèmes de performances liés à une imbrication trop importante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la profondità della scansione ricorsiva delle cartelle per evitare problemi di prestazioni con cartelle troppo nidificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深く入れ子になったフォルダによるパフォーマンス低下を避けるため、再帰スキャンの深さを制限します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더가 너무 깊게 중첩되어 성능 문제가 생기지 않도록 재귀 검색 깊이를 제한합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничьте глубину рекурсивного сканирования каталогов, чтобы избежать проблем с производительностью из-за слишком глубокой вложенности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制递归扫描子目录的层级，以避免因目录过深导致性能问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制遞迴掃描子目錄的層級，以避免因目錄過深導致效能問題。"
          }
        }
      }
    },
