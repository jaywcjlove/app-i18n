    "Permanently drawn on frames. Style matches preview; cannot re-import as text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauerhaft in die Frames gezeichnet. Stil entspricht der Vorschau; kann nicht als Text erneut importiert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessiné de façon permanente sur les images. Le style correspond à l'aperçu ; ne peut pas être réimporté en tant que texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegnato permanentemente sui fotogrammi. Lo stile corrisponde all'anteprima; non può essere reimportato come testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレームに永続的に描画されます。スタイルはプレビューと一致します。テキストとして再インポートできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프레임에 영구적으로 그려집니다. 스타일은 미리보기와 일치하며, 텍스트로 다시 가져올 수 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навсегда нарисовано на кадрах. Стиль соответствует предпросмотру; повторный импорт как текст невозможен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久绘制在帧上。样式与预览一致；无法作为文本重新导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久繪製在幀上。樣式與預覽一致；無法作為文字重新匯入。"
          }
        }
      }
    },
