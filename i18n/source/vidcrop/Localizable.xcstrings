    "%lld people selected. Tap a face again to deselect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Personen ausgewählt. Tippe erneut auf ein Gesicht, um die Auswahl aufzuheben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld personnes sélectionnées. Appuyez à nouveau sur un visage pour désélectionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld persone selezionate. Tocca di nuovo un volto per deselezionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld人選択中。顔をもう一度タップして選択解除。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld명 선택됨. 얼굴을 다시 탭하여 선택 해제."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбрано %lld чел. Нажмите на лицо еще раз, чтобы отменить выбор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已选择 %lld 人。再次点击面部以取消选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已選擇 %lld 人。再次點擊面部以取消選擇。"
          }
        }
      }
    },
