    "1 person selected. Tap again to deselect, or select more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Person ausgewählt. Erneut tippen zum Abwählen oder weitere auswählen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 personne sélectionnée. Appuyez à nouveau pour désélectionner, ou sélectionnez-en plus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1人選択中。もう一度タップで選択解除、またはさらに選択。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1명 선택됨. 다시 탭하여 선택 해제하거나 더 선택하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбран 1 человек. Нажмите еще раз, чтобы отменить выбор, или выберите еще."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已选择 1 人。再次点击取消选择，或继续选择更多人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已選擇 1 人。再次點擊取消選擇，或繼續選擇更多人。"
          }
        }
      }
    },
