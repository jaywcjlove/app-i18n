    "🚨 Successfully set %@ icons, but failed to set icons for %@ folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚨 %1$@ Symbole wurden erfolgreich gesetzt, aber für %2$@ Ordner konnten keine Symbole gesetzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "🚨 Successfully set %1$@ icons, but failed to set icons for %2$@ folders."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚨 %1$@ icônes ont été définies avec succès, mais la définition des icônes a échoué pour %2$@ dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚨 %1$@ icone impostate correttamente, ma impossibile impostare le icone per %2$@ cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚨 %1$@ 個のアイコン設定に成功しましたが、%2$@ 個のフォルダでアイコン設定に失敗しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚨 아이콘 %1$@개를 성공적으로 설정했지만, %2$@개 폴더의 아이콘 설정에 실패했습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚨 Успешно установлено %1$@ значков, но не удалось установить значки для %2$@ папок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚨 成功设置 %1$@ 个图标，但未能为 %2$@ 个文件夹设置图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚨 成功設定 %1$@ 個圖示，但未能為 %2$@ 個資料夾設定圖示。"
          }
        }
      }
    },
