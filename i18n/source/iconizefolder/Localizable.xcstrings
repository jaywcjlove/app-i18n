    "Are you sure you want to clear the current settings? You will be returned to the home page after this action." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie die aktuellen Einstellungen wirklich löschen? Nach dieser Aktion werden Sie zur Startseite zurückgeführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir effacer les paramètres actuels ? Vous serez redirigé vers la page d’accueil après cette action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler cancellare le impostazioni correnti? Dopo questa azione verrai riportato alla home page."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の設定をクリアしてもよろしいですか？この操作後、ホームページに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 설정을 지우시겠습니까? 이 작업 후 홈 페이지로 돌아갑니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите очистить текущие настройки? После этого действия вы будете возвращены на главную страницу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您确定要清除当前设置吗？此操作后将返回到主页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要清除目前設定嗎？此操作後將返回主頁。"
          }
        }
      }
    },
