            "value" : "指定されたパスにフォルダが存在しません: %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지정된 경로에 폴더가 존재하지 않습니다: %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
