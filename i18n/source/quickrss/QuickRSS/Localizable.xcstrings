    "Listens on 127.0.0.1 only. QuickRSS must stay open while AI clients are connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört nur auf 127.0.0.1. QuickRSS muss geöffnet bleiben, solange KI-Clients verbunden sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute uniquement sur 127.0.0.1. QuickRSS doit rester ouvert tant que des clients d’IA sont connectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta solo su 127.0.0.1. QuickRSS deve rimanere aperto mentre i client IA sono connessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "127.0.0.1 のみで待ち受けます。AI クライアントの接続中は QuickRSS を開いたままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "127.0.0.1에서만 수신합니다. AI 클라이언트가 연결되어 있는 동안 QuickRSS를 계속 열어 두어야 합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прослушивает только 127.0.0.1. QuickRSS должен оставаться открытым, пока подключены клиенты ИИ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅监听 127.0.0.1。AI 客户端连接期间必须保持 QuickRSS 开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅監聽 127.0.0.1。AI 用戶端連線期間必須保持 QuickRSS 開啟。"
          }
        }
      }
    },
