    "Sync subscriptions (title, link, URL) across your devices. Article content stays on this device. Restart the app after changing this setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements (Titel, Link, URL) auf deinen Geräten synchronisieren. Artikelinhalte bleiben auf diesem Gerät. Starte die App nach Änderung dieser Einstellung neu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisez les abonnements (titre, lien, URL) entre vos appareils. Le contenu des articles reste sur cet appareil. Redémarrez l’app après avoir modifié ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza gli abbonamenti (titolo, link, URL) tra i tuoi dispositivi. I contenuti degli articoli restano su questo dispositivo. Riavvia l’app dopo aver modificato questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購読（タイトル、リンク、URL）をデバイス間で同期します。記事本文はこのデバイスにのみ保存されます。この設定を変更したらアプリを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독(제목, 링크, URL)을 기기 간에 동기화합니다. 기사 내용은 이 기기에만 저장됩니다. 이 설정을 변경한 후 앱을 다시 시작하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизируйте подписки (название, ссылка, URL) между устройствами. Текст статей остаётся на этом устройстве. Перезапустите приложение после изменения этого параметра."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多台设备间同步订阅源（标题、链接、网址）。文章内容仅保存在本机。更改此选项后请重启应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多台裝置間同步訂閱源（標題、連結、網址）。文章內容僅保存在本機。更改此選項後請重新啟動應用程式。"
          }
        }
