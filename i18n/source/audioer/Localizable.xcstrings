    "Apply artwork to %d selected audios.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した%d個の音声にアートワークを適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 %d개 오디오에 아트워크를 적용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将封面应用到选中的 %d 个音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將封面套用到選取的 %d 個音訊。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover auf %d ausgewählte Audios anwenden."
          }
        }
      }
    },
