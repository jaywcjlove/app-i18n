    "Missing or damaged RAR volume. Make sure %@ is in the same folder and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlendes oder beschädigtes RAR-Volume. Stellen Sie sicher, dass sich %@ im selben Ordner befindet, und versuchen Sie es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume RAR manquant ou endommagé. Vérifiez que %@ se trouve dans le même dossier et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAR ボリュームが見つからないか破損しています。%@ が同じフォルダにあることを確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAR 분할 볼륨이 없거나 손상되었습니다. %@가 같은 폴더에 있는지 확인한 후 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсутствует или поврежден том RAR. Убедитесь, что %@ находится в той же папке, и попробуйте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAR 分卷丢失或损坏。请确保 %@ 位于同一文件夹后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAR 分卷遺失或損壞。請確保 %@ 位於同一資料夾後重試。"
          }
        }
      }
    },
    "Missing or damaged RAR volume. Make sure all related RAR volume files are in the same folder and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlendes oder beschädigtes RAR-Volume. Stellen Sie sicher, dass sich alle zugehörigen RAR-Volumendateien im selben Ordner befinden, und versuchen Sie es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume RAR manquant ou endommagé. Vérifiez que tous les fichiers de volume RAR associés se trouvent dans le même dossier et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAR ボリュームが見つからないか破損しています。すべての関連する RAR ボリュームファイルが同じフォルダにあることを確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAR 분할 볼륨이 없거나 손상되었습니다. 모든 관련 RAR 분할 볼륨 파일이 같은 폴더에 있는지 확인한 후 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсутствует или поврежден том RAR. Убедитесь, что все связанные тома RAR находятся в одной папке, и попробуйте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAR 分卷丢失或损坏。请确保所有相关的 RAR 分卷文件都在同一文件夹后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
