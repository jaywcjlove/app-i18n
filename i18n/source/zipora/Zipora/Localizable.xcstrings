    "Select a folder or archive, then press **Space** or **Command + Y** to preview its contents with Quick Look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahlen Sie einen Ordner oder ein Archiv aus und drucken Sie dann **Leertaste** oder **Command + Y**, um den Inhalt mit Quick Look anzuzeigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un dossier ou une archive, puis appuyez sur **Espace** ou **Commande + Y** pour prévisualiser son contenu avec Quick Look."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダまたはアーカイブを選び、**Space** または **Command + Y** を押して Quick Look で内容をプレビューします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더나 아카이브를 선택한 다음 **Space** 또는 **Command + Y**를 눌러 Quick Look으로 내용을 미리 보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите папку или архив, затем нажмите **Space** или **Command + Y**, чтобы просмотреть содержимое через Quick Look."
          }
        },
        "zh-Hans" : {
