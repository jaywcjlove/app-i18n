    "There are %lld items in total. This action will permanently delete all your clipboard history and cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind insgesamt %lld Einträge vorhanden. Diese Aktion löscht den gesamten Zwischenablageverlauf dauerhaft und kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a %lld éléments au total. Cette action supprimera définitivement tout l’historique du presse-papiers et est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合計 %lld 件あります。この操作はクリップボード履歴を完全に削除し、元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "총 %lld개의 항목이 있습니다. 이 작업은 클립보드 기록을 영구적으로 삭제하며 되돌릴 수 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всего элементов: %lld. Это действие безвозвратно удалит всю историю буфера обмена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
