    "Enable or disable clipboard history tracking. When disabled, the feature will no longer be available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren oder deaktivieren Sie die Verlaufsüberwachung der Zwischenablage. Im deaktivierten Zustand steht die Funktion nicht mehr zur Verfügung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez ou désactivez le suivi de l’historique du presse-papiers. Une fois désactivé, cette fonctionnalité ne sera plus disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva il monitoraggio della cronologia degli appunti. Se disattivato, la funzione non sarà più disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボード履歴の追跡を有効または無効にします。無効にすると、この機能は利用できなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드 기록 추적을 켜거나 끕니다. 끄면 이 기능을 사용할 수 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите или отключите запись истории буфера обмена. После отключения функция будет недоступна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật hoặc tắt theo dõi lịch sử khay nhớ tạm. Khi tắt, tính năng này sẽ không còn khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用或禁用剪切板历史记录跟踪，禁用后该功能将不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用或停用剪貼板歷史記錄追蹤。停用後，此功能將無法使用。"
          }
        }
      }
    },
