    "**%@** permission is enabled. **%@** can now paste with keyboard shortcuts and insert text into input fields." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die **%1$@**-Berechtigung ist aktiv. **%2$@** kann jetzt per Tastaturkurzbefehl einfügen und Text in Eingabefelder einsetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès **%1$@** est activé. **%2$@** peut désormais coller avec un raccourci clavier et insérer du texte dans les champs de saisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'autorizzazione **%@** è attiva. **%@** ora può incollare con le scorciatoie da tastiera e inserire testo nei campi di input."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%1$@** のアクセス権が有効です。**%2$@** はキーボードショートカットでの貼り付けと入力欄へのテキスト挿入ができるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%1$@** 권한이 켜졌습니다. 이제 **%2$@**에서 키보드 단축키로 붙여넣고 입력란에 텍스트를 삽입할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ **%1$@** включён. **%2$@** теперь может вставлять текст сочетанием клавиш и в поля ввода."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền **%@** đã được bật. **%@** giờ có thể dán bằng phím tắt và chèn văn bản vào các trường nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%1$@** 权限已开启。**%2$@** 现在可以使用快捷键粘贴，并向输入框插入文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%1$@** 權限已開啟。**%2$@** 現在可以使用快速鍵貼上，並向輸入欄插入文字。"
          }
        }
      }
    },
