    "Your generous financial assistance, I have great confidence in keeping %@ healthy and maintaining it actively." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Ihre großzügige finanzielle Unterstützung bin ich zuversichtlich, %@ gesund zu halten und aktiv zu pflegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grâce à votre généreuse aide financière, j'ai pleinement confiance pour garder %@ en bonne santé et l'entretenir activement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの寛大な資金援助により、%@を健全に保ち、積極的に維持することに大きな自信を持っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러분의 아낌없는 재정적 지원 덕분에 %@를 건강하게 유지하고 적극적으로 관리하는 데 큰 자신감을 갖고 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Благодаря вашей щедрой финансовой поддержке я уверен в том, что смогу поддерживать %@ в работоспособном состоянии и активно развивать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢您慷慨的经济援助，我很有信心让 %@ 保持健康发展并持续维护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感謝您慷慨的經濟援助，我很有信心讓 %@ 保持健康發展並持續維護。"
          }
        }
      }
    }
  },
