    "Keyboard shortcut paste or inserting text into an input field requires **%@** access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Einfügen per Tastaturkurzbefehl oder in ein Eingabefeld erfordert Zugriff auf **%@**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coller avec un raccourci clavier ou insérer du texte dans un champ de saisie nécessite l’accès **%@**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incollare con una scorciatoia da tastiera o inserire testo in un campo di input richiede l'accesso a **%@**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードショートカットでの貼り付け、または入力欄へのテキスト挿入には **%@** へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드 단축키로 붙여넣거나 입력란에 텍스트를 삽입하려면 **%@** 접근 권한이 필요합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для вставки сочетанием клавиш или вставки текста в поле ввода требуется доступ к **%@**."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán bằng phím tắt hoặc chèn văn bản vào trường nhập cần quyền truy cập **%@**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷键粘贴或者向输入框插入文本需要开启 **%@** 访问。"
