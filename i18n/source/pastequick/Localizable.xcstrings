    "Your generous financial assistance, I have great confidence in keeping %@ healthy and maintaining it actively." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Ihre großzügige finanzielle Unterstützung bin ich zuversichtlich, %@ gesund zu halten und aktiv zu pflegen."
          }
