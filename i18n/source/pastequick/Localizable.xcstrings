    "After deselection, this type of clipboard data will no longer be recorded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Abwählen wird dieser Zwischenablagetyp nicht mehr aufgezeichnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois désélectionné, ce type de données du presse-papiers ne sera plus enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択を解除すると、この種類のクリップボードデータは記録されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택을 해제하면 이 유형의 클립보드 데이터는 더 이상 기록되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После снятия выбора этот тип данных буфера обмена больше не будет записываться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消选择后，将不再记录此类型的剪贴板数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消選取後，將不再記錄此類型的剪貼板資料。"
          }
        }
      }
    },
    "After disabling, character sets containing only Unicode General Category Z*, U+000A to U+000D, and U+0085 will no longer be recorded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Deaktivieren werden Zeichenfolgen, die nur Unicode-Kategorie Z*, U+000A bis U+000D und U+0085 enthalten, nicht mehr erfasst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois désactivé, les jeux de caractères contenant uniquement la catégorie générale Unicode Z*, U+000A à U+000D et U+0085 ne seront plus enregistrés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効にすると、Unicode一般カテゴリ Z*、U+000A〜U+000D、および U+0085 のみを含む文字列は記録されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 Unicode 일반 범주 Z*, U+000A~U+000D, U+0085만 포함된 문자열은 더 이상 기록되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После отключения наборы символов, содержащие только Unicode-категорию Z*, U+000A–U+000D и U+0085, больше не записываются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁用后，仅包含 Unicode 通用类别 Z*、U+000A 至 U+000D 及 U+0085 的字符集将不再被记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用後，僅包含 Unicode 一般類別 Z*、U+000A 至 U+000D 及 U+0085 的字元集將不再被記錄。"
          }
        }
      }
    },
